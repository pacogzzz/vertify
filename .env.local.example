# Copia este archivo a .env.local y llena tus valores.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # publishable key (o legacy anon)
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app     # para los links de confirmación de correo

# --- Solo server. NUNCA exponer al cliente ---
SUPABASE_SERVICE_ROLE_KEY=...
GEMINI_API_KEY=AQ....                              # Google AI Studio (free tier)
# ANTHROPIC_API_KEY=sk-ant-...                     # opcional: fallback de OCR de pago
# OCR_PROVIDER=gemini                              # gemini (default) | anthropic
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Aviso por correo cuando el efectivo baja de $700 (opcional) ---
# Sin estas variables, el aviso solo aparece dentro de la app.
# RESEND_API_KEY=re_...                            # https://resend.com (plan gratis: 100 correos/día)
# EMAIL_FROM=Vertify <avisos@tudominio.com>        # remitente verificado en Resend
